{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized Firebase administrator account registered in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "admin"] },
        "displayName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Portal branding, social links, contact details, and homepage section visibility.",
      "type": "object",
      "properties": {
        "portalName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "institutionName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tagline": { "type": "string", "maxLength": 240 },
        "description": { "type": "string", "maxLength": 1000 },
        "logoUrl": { "type": "string", "maxLength": 600000 },
        "faviconUrl": { "type": "string", "maxLength": 600000 },
        "bannerUrl": { "type": "string", "maxLength": 700000 },
        "primaryColor": { "type": "string", "maxLength": 32 },
        "accentColor": { "type": "string", "maxLength": 32 },
        "whatsappNumber": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "instagramUrl": { "type": "string", "maxLength": 500 },
        "facebookUrl": { "type": "string", "maxLength": 500 },
        "youtubeUrl": { "type": "string", "maxLength": 500 },
        "tiktokUrl": { "type": "string", "maxLength": 500 },
        "websiteUrl": { "type": "string", "maxLength": 500 },
        "copyrightText": { "type": "string", "maxLength": 300 },
        "heroEnabled": { "type": "boolean" },
        "announcementsEnabled": { "type": "boolean" },
        "registrationsEnabled": { "type": "boolean" },
        "documentsEnabled": { "type": "boolean" },
        "searchEnabled": { "type": "boolean" },
        "categoriesEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "portalName",
        "institutionName",
        "primaryColor",
        "accentColor",
        "heroEnabled",
        "announcementsEnabled",
        "registrationsEnabled",
        "documentsEnabled",
        "searchEnabled",
        "categoriesEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "QrSettings": {
      "title": "QrSettings",
      "description": "QR code generator and printable poster settings.",
      "type": "object",
      "properties": {
        "portalUrl": { "type": "string", "maxLength": 500 },
        "size": { "type": "number" },
        "foregroundColor": { "type": "string", "maxLength": 32 },
        "backgroundColor": { "type": "string", "maxLength": 32 },
        "includeLogo": { "type": "boolean" },
        "logoUrl": { "type": "string", "maxLength": 600000 },
        "errorCorrectionLevel": { "type": "string", "enum": ["L", "M", "Q", "H"] },
        "posterTitle": { "type": "string", "maxLength": 160 },
        "posterSubtitle": { "type": "string", "maxLength": 300 },
        "posterFooter": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "size",
        "foregroundColor",
        "backgroundColor",
        "includeLogo",
        "errorCorrectionLevel",
        "posterTitle",
        "posterSubtitle",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Service link category.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 80 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "icon", "order", "isActive", "createdAt", "updatedAt"]
    },
    "ServiceLink": {
      "title": "ServiceLink",
      "description": "Digital portal service shortcut card.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "iconType": { "type": "string", "enum": ["lucide", "image", "upload"] },
        "icon": { "type": "string", "maxLength": 700000 },
        "targetUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "targetOpen": { "type": "string", "enum": ["_blank", "_self"] },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "clicksCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "iconType",
        "icon",
        "targetUrl",
        "targetOpen",
        "order",
        "isActive",
        "clicksCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Important madrasah announcement with optional banner image.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "imageUrl": { "type": "string", "maxLength": 700000 },
        "publishDate": { "type": "string", "maxLength": 40 },
        "expiryDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "publishDate", "status", "createdAt", "updatedAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "PPDB / admission registration program.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "bannerUrl": { "type": "string", "maxLength": 700000 },
        "formUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "formUrl", "status", "order", "isActive", "createdAt", "updatedAt"]
    },
    "DocumentItem": {
      "title": "DocumentItem",
      "description": "Downloadable official document or brochure.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 80 },
        "fileUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "fileType": { "type": "string", "maxLength": 24 },
        "fileSize": { "type": "string", "maxLength": 40 },
        "downloadCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "category",
        "fileUrl",
        "fileType",
        "downloadCount",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "CommitteeContact": {
      "title": "CommitteeContact",
      "description": "Official WhatsApp committee contact person.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "minLength": 1, "maxLength": 120 },
        "whatsappNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 300 },
        "isAvailable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "whatsappNumber", "isAvailable", "createdAt", "updatedAt"]
    },
    "MadrasahAchievement": {
      "title": "MadrasahAchievement",
      "description": "Madrasah achievement gallery item with photo and short description.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 100 },
        "recipient": { "type": "string", "maxLength": 160 },
        "year": { "type": "string", "maxLength": 20 },
        "photoUrl": { "type": "string", "maxLength": 700000 },
        "shortDescription": { "type": "string", "maxLength": 1000 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "shortDescription", "order", "isActive", "createdAt", "updatedAt"]
    },
    "StudentAchievement": {
      "title": "StudentAchievement",
      "description": "Student achievement submission awaiting or after admin verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "registrationNumberOrNisn": { "type": "string", "minLength": 1, "maxLength": 64 },
        "achievementTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "field": { "type": "string", "maxLength": 80 },
        "level": { "type": "string", "maxLength": 80 },
        "rank": { "type": "string", "maxLength": 80 },
        "organizer": { "type": "string", "maxLength": 160 },
        "year": { "type": "string", "maxLength": 20 },
        "certificateUrl": { "type": "string", "maxLength": 750000 },
        "certificateFileName": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "studentName",
        "registrationNumberOrNisn",
        "achievementTitle",
        "field",
        "level",
        "rank",
        "year",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized admin accounts verified via email or document lookup."
    },
    "/site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site settings document (id: default)."
    },
    "/qr_settings/{settingId}": {
      "schema": { "$ref": "#/entities/QrSettings" },
      "description": "Global QR settings document (id: default)."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Service link categories."
    },
    "/links/{linkId}": {
      "schema": { "$ref": "#/entities/ServiceLink" },
      "description": "Portal digital service links."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Official madrasah announcements."
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "PPDB and registration programs."
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/DocumentItem" },
      "description": "Official downloadable brochures and guides."
    },
    "/committee_contacts/{contactId}": {
      "schema": { "$ref": "#/entities/CommitteeContact" },
      "description": "Official WhatsApp committee contact directory."
    },
    "/madrasah_achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/MadrasahAchievement" },
      "description": "Madrasah achievement gallery showcased on the home page."
    },
    "/student_achievements/{achievementId}": {
      "schema": { "$ref": "#/entities/StudentAchievement" },
      "description": "Student achievement submissions with PII (admin-only read/list/verify)."
    }
  }
}
